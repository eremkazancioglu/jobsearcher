# Get credentials at https://developer.adzuna.com/
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here

# Two-letter country code Adzuna uses in its endpoint path, e.g. gb, us, de
ADZUNA_COUNTRY=gb

# Used by the Claude Agent SDK for capture confirmation/extraction and the
# tier 3 fallback web search (agents/fetchers.py)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Neon Postgres connection string -- point local runs at a `dev` branch,
# not `main` (see CLAUDE.md's Environments section)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
